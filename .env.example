# BDoor environment configuration.
#
# Copy to `.env.local` and fill in. NEVER commit a filled-in file.
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle — never
# put a secret behind that prefix.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG images,
# sitemap entries and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable ("anon") key. Safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret ("service role") key. SERVER ONLY. Bypasses RLS entirely.
# Required in production. Used for webhooks, anonymous questionnaire drafts,
# invitation-token lookup and the restricted compliance schema.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# mock | sslcommerz | stripe. Only `mock` has an adapter today; the others
# throw on startup until one is implemented. See README → payment gateway.
PAYMENT_PROVIDER=mock
# HMAC secret used to verify inbound webhook signatures. Required when
# PAYMENT_PROVIDER is not `mock`. At least 16 characters.
PAYMENT_WEBHOOK_SECRET=
# Optional override for where the gateway returns the customer after checkout.
PAYMENT_RETURN_URL=

# SSLCOMMERZ merchant credentials. Reserved: read only once the SSLCommerz
# adapter lands (Phase 5). Sandbox and live are chosen by SSLCOMMERZ_IS_LIVE,
# never by guessing from the store id.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# mock | resend | smtp. `mock` logs a redacted summary and sends nothing.
EMAIL_PROVIDER=mock
# Required when EMAIL_PROVIDER is not `mock`.
EMAIL_FROM=
# Provider API key. SERVER ONLY. Required when EMAIL_PROVIDER is not `mock`.
EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Compliance and security integrations
# ---------------------------------------------------------------------------
# mock | live. `mock` NEVER contacts a sanctions or PEP list and every result
# it returns is labelled as a non-screening in the UI.
SCREENING_PROVIDER=mock
# mock | live. `mock` leaves uploads in a `pending` scan state — it never
# marks an unscanned file clean.
MALWARE_SCAN_PROVIDER=mock
# Scanner API key. SERVER ONLY. Required when MALWARE_SCAN_PROVIDER is `live`.
MALWARE_SCAN_API_KEY=

# Cloudflare Turnstile for high-abuse public forms. Reserved: wired once the
# privacy/vendor review in docs/LEGAL_LAUNCH_CHECKLIST.md is signed off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Application-level encryption for selected sensitive structured fields.
# SERVER ONLY, rotatable: write the new key to _CURRENT and move the old one to
# _PREVIOUS so in-flight rows stay readable through a rotation.
APP_ENCRYPTION_KEY_CURRENT=
APP_ENCRYPTION_KEY_PREVIOUS=

# Shared secret for scheduled job endpoints (reminders, retention sweeps).
# A job route must reject any request that does not present it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# disabled | anthropic. The recommendation engine works fully with `disabled`.
AI_PROVIDER=disabled
# Required when AI_PROVIDER is not `disabled`.
AI_API_KEY=

# ---------------------------------------------------------------------------
# Ask bdoor AI
# ---------------------------------------------------------------------------
# Defaults ON everywhere (owner release decision, 30 Aug 2026) — the assistant
# is a published feature. `false` is the kill switch and always wins.
ASK_BDOOR_AI_ENABLED=true
#
# LOCAL DEVELOPMENT ONLY. Deployed environments authenticate to AI Gateway with
# Vercel OIDC, which the SDK reads from the runtime — no secret in project
# settings. Setting this in production logs a warning at boot; remove it there.
AI_GATEWAY_API_KEY=
#
# Application-side spend caps, checked against the ai_usage ledger before every
# answer. The ENFORCED caps are the AI Gateway budgets, which are set outside
# this file and reject at the gateway with HTTP 402:
#
#   vercel ai-gateway budgets set project bdoor-io --limit 40 --refresh-period daily
#   vercel ai-gateway budgets set team --limit 600 --refresh-period monthly
#
AI_DAILY_BUDGET_USD=25
AI_MONTHLY_BUDGET_USD=400
#
# Salt for the hashed safety identifier sent to AI Gateway with each request.
# Recommended in production; when unset the salt falls back to a value derived
# from SUPABASE_SECRET_KEY (still server-only), with a boot warning.
AI_IDENTITY_SALT=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
# Source-map upload token. CI ONLY — belongs in GitHub secrets, never in a
# runtime environment or the repository.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Local development conveniences
# ---------------------------------------------------------------------------
# true disables rate limiting. Never set this in production.
RATE_LIMIT_DISABLED=false
# Set to false on a preview deployment that intentionally runs without
# production secrets. In production leave it unset: an incomplete environment
# then fails the boot instead of 500-ing at request time.
STRICT_ENV=true
# true enables privacy-conscious analytics once one is configured.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# 1 flags every first-party analytics event as test traffic (is_test = true),
# excluding it from investor metrics. Set in CI and rehearsal environments;
# never in production (docs/EVENT_TAXONOMY.md).
ANALYTICS_TEST_MODE=0

# ---------------------------------------------------------------------------
# Launch gates (see src/lib/launch/gates.ts and docs/LEGAL_REVIEW_CHECKLIST.md)
#
# The v1.0 legal suite is published (owner release, 30 Aug 2026), so
# LEGAL_CONTENT_STATUS defaults to `approved`; `draft` (or
# LEGAL_LAUNCH_APPROVED=false) is the kill switch that restores the draft
# banner, noindex and the forced-closed posture. Payments, checkout and KYC
# still default to disabled on their own variables — publishing policies opens
# no chargeable or identity-collecting flow.
LEGAL_CONTENT_STATUS=approved         # draft | approved
# Owner-facing kill switch: when explicitly false, forces draft posture and
# keeps payments/KYC closed. Leave unset to follow LEGAL_CONTENT_STATUS alone.
LEGAL_LAUNCH_APPROVED=                # true | false
BANGLADESH_CHECKOUT_STATUS=disabled   # disabled | quote_only | enabled
KYC_UPLOAD_STATUS=disabled            # disabled | enabled
PAYMENTS_STATUS=disabled              # disabled | enabled
# Provider applications (/partners/apply). Open by default since the go-live
# release; every submission still passes admin verification before a provider
# can receive a case. `disabled` is the kill switch.
PROVIDER_APPLICATIONS_STATUS=enabled  # disabled | enabled

# ---------------------------------------------------------------------------
# Display-currency FX (see src/lib/fx). Approximate USD equivalents render on
# public package cards ONLY while an owner-reviewed rate is configured here —
# leave unset to show BDT alone. Never paste an unreviewed rate: the review
# date renders publicly beside every converted figure ("Rate checked …").
# Ledger and invoice amounts never use this rate.
# FX_USD_BDT_RATE=                    # BDT per 1 USD, e.g. 123.07
# FX_USD_BDT_REVIEWED_AT=             # ISO date of the owner's review, e.g. 2026-08-29
