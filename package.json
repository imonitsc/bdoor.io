{
  "name": "bdoor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config vitest.config.mts run",
    "test:watch": "vitest --config vitest.config.mts",
    "test:unit": "vitest --config vitest.config.mts run tests/unit",
    "test:integration": "vitest --config vitest.config.mts run tests/integration",
    "test:coverage": "vitest --config vitest.config.mts run tests/unit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:passwordless": "AUTH_PASSWORDLESS=true playwright test tests/e2e/passwordless-auth.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.150",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.146",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "unpdf": "^1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
